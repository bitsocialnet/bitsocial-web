          "editorMode": "code",
          "expr": "(sum(((max without(client_id, instance, job, service, subplebbit_address) (bitsocial_stats_last_community_update_fetch_seconds_since_updated_at{client_id=\"5chan\"}) < bool 7200) * max without(client_id, instance, job, service, subplebbit_address) (bitsocial_stats_last_community_update_fetch_success{client_id=\"5chan\"})) or (max without(client_id, instance, job, service, subplebbit_address) (bitsocial_stats_last_community_update_fetch_success{client_id=\"5chan\"}) * 0)) or vector(0))",
